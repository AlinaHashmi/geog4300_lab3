knitr::opts_chunk$set(echo = TRUE)
library(tidyverse)
library(terra)
library(sf)
library(tmap)
library(knitr)
tree_data<-read_csv("data/gatree_obs_inat.csv") %>%
st_as_sf(coords=c("longitude", "latitude"), crs=4326)
tm_shape(tree_data) +
tm_dots(fill = "gentype")
ga_cty <- st_read("data/ACSCtyData_2022ACS_simplify.gpkg") %>%
st_transform(4326) %>%
filter(st_name == "Georgia")
ga_trees <- tree_data %>%
st_join(ga_cty)
ga_trees_df <- ga_trees %>%
st_set_geometry(NULL)
ga_trees_count <- ga_trees_df %>%
count(cty_name, gentype)
ga_trees_count_wide <- ga_trees_count %>%
pivot_wider(
names_from = gentype,
values_from = n,
values_fill = 0
)
gacounty_tree_observations <- ga_trees_df %>%
count(gentype)
total_observations = nrow(ga_trees_df)
#live oak trees in county/total number of trees in county
ga_trees_count_wide <- ga_trees_count_wide %>%
mutate (
total_observations = `Dogwood` + `Live oak` + `Pecan` + `Rhododendron`,
lo_pct = `Live oak` / total_observations * 100
)
#live oak trees in ga
lo_observations = nrow(ga_trees_df %>% filter(gentype == "Live oak"))
#live oak trees in ga/total number of trees in ga
area_ratio = lo_observations/total_observations*100
#finding lq of live oak trees for each county
ga_trees_count_wide <- ga_trees_count_wide %>%
mutate(lo_lq = lo_pct/area_ratio)
ga_trees <- left_join(ga_trees, ga_trees_count_wide, by = "cty_name")
ga_trees_cleaned <- ga_trees %>%
distinct(cty_name, .keep_all = TRUE)
tm_shape(ga_trees_cleaned)+
tm_dots(fill = "lo_lq")
julytemp <- rast("data/temp_july2022_2024/temperature_2m_2024-07-01.tif")
julytemp_celsius <- julytemp - 273.15
plot(julytemp_celsius)
julytemp_files <- list.files("data/temp_july2022_2024",
pattern = "\\.tif$",
full.names = T)
julytemp2022 <- rast(julytemp_files)
julytemp2022_celsius <- julytemp2022 - 273.15
julytemp2022_mean <- mean(julytemp2022_celsius)
extracted_mean <- terra::extract(julytemp2022_mean, tree_data)
tree_data <- tree_data %>%
mutate(july_mean_temp = extracted_mean[,2]
)
kable(head(tree_data))
tree_data <- tree_data %>%
mutate(longitude = st_coordinates(.)[, "X"],
latitude = st_coordinates(.)[, "Y"]
)
summary_stats <- tree_data %>%
group_by(gentype) %>%
summarize(
mean_temp = mean(july_mean_temp),
sd_temp = sd(july_mean_temp),
mean_long = mean(longitude),
mean_lat = mean(latitude)
)
kable(head(summary_stats))
View(summary_stats)
View(tree_data)
tree_data <- tree_data %>%
mutate(longitude = st_coordinates(.)[, "X"],
latitude = st_coordinates(.)[, "Y"]
)
summary_stats <- tree_data %>%
group_by(gentype) %>%
summarize(
mean_temp = mean(july_mean_temp, na.rm = TRUE),
sd_temp = sd(july_mean_temp, na.rm = TRUE),
mean_long = mean(longitude, na.rm = TRUE),
mean_lat = mean(latitude, na.rm = TRUE)
)
kable(head(summary_stats))
View(summary_stats)
tmap_style("cobalt")
tm_shape(ga_trees_cleaned)+
tm_dots(fill = "lo_lq")
tm_shape(ga_trees_cleaned)+
tm_dots(fill = "lo_lq") +
tm_style("classic")
ga_trees <- left_join(ga_trees, ga_trees_count_wide, by = "cty_name")
ga_trees_cleaned <- ga_trees %>%
distinct(cty_name, .keep_all = TRUE)
tm_shape(ga_trees_cleaned)+
tm_dots(fill = "lo_lq") +
tm_layout(
bg.color = "lightblue"
)
ga_trees <- left_join(ga_trees, ga_trees_count_wide, by = "cty_name")
ga_trees_cleaned <- ga_trees %>%
distinct(cty_name, .keep_all = TRUE)
tm_shape(ga_trees_cleaned)+
tm_polygons(fill = "lo_lq")
