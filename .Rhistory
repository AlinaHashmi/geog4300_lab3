julytemp_celsius <- julytemp - 273.15
plot(julytemp_celsius)
julytemp_files <- list.files("data/temp_july2022_2024",
pattern = "\\.tif$",
full.names = T)
julytemp2022 <- rast(julytemp_files)
julytemp2022_celsius <- julytemp2022 - 273.15
julytemp2022_mean <- mean(julytemp2022_celsius)
extracted_mean <- terra::extract(julytemp2022_mean, tree_data)
tree_data <- tree_data %>%
mutate(july_mean_temp = extracted_mean[,2]
)
kable(head(tree_data))
tree_data <- tree_data %>%
mutate(longitude = st_coordinates(.)[, "X"],
latitude = st_coordinates(.)[, "Y"]
)
summary_stats <- tree_data %>%
group_by(gentype) %>%
summarize(
mean_temp = mean(july_mean_temp, na.rm = TRUE),
sd_temp = sd(july_mean_temp, na.rm = TRUE),
mean_long = mean(longitude, na.rm = TRUE),
mean_lat = mean(latitude, na.rm = TRUE)
)
kable(head(summary_stats))
