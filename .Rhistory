library(tidyverse)
library(terra)
library(sf)
library(tmap)
library(knitr)
tree_data<-read_csv("data/gatree_obs_inat.csv") %>%
st_as_sf(coords=c("longitude", "latitude"), crs=4326)
tm_shape(tree_data) +
tm_dots(fill = "gentype")
ga_cty <- st_read("data/ACSCtyData_2022ACS_simplify.gpkg") %>%
st_transform(4326) %>%
filter(st_name == "Georgia")
ga_trees <- tree_data %>%
st_join(ga_cty)
ga_trees_df <- ga_trees %>%
st_set_geometry(NULL)
ga_trees_count <- ga_trees_df %>%
count(cty_name, gentype)
ga_trees_count_wide <- ga_trees_count %>%
pivot_wider(
names_from = gentype,
values_from = n,
values_fill = 0
)
gacounty_tree_observations <- ga_trees_df %>%
count(gentype)
total_observations = nrow(ga_trees_df)
gacounty_tree_observations <- ga_trees_df %>%
count(gentype)
total_observations = nrow(ga_trees_df)
#live oak trees in county/total number of trees in county
ga_trees_count_wide <- ga_trees_count_wide %>%
mutate (
total_observations = `Dogwood` + `Live oak` + `Pecan` + `Rhododendron`,
lo_pct = `Live oak` / total_observations * 100
)
#live oak trees in ga
lo_observations = nrow(ga_trees_df %>% filter(gentype == "Live oak"))
#live oak trees in ga/total number of trees in ga
area_ratio = lo_observations/total_observations*100
#finding lq of live oak trees for each county
ga_trees_count_wide <- ga_trees_count_wide %>%
mutate(lo_lq = lo_pct/area_ratio)
ga_trees <- left_join(ga_trees, ga_trees_count_wide, by = "cty_name")
ga_trees_cleaned <- ga_trees %>%
distinct(cty_name, .keep_all = TRUE)
tm_shape(ga_trees_cleaned)+
tm_polygons(fill = "lo_lq")
tm_shape(ga_trees_cleaned)+
tm_dots(fill = "lo_lq")
tm_shape(ga_trees_cleaned)+
tm_dots(fill = "lo_lq") +
tm_layout(
bg.color = "black"
)
tm_shape(ga_trees_cleaned)+
tm_dots(fill = "lo_lq") +
tm_layout(
bg.color = "grey"
)
